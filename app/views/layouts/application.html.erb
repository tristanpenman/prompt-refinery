<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Prompt Refinery" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% flash.each do |type, message| %>
      <div class="flash flash--<%= type %>" role="<%= type == "alert" ? "alert" : "status" %>"><%= message %></div>
    <% end %>
    <%= yield %>
  </body>
</html>
