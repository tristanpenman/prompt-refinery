<% content_for :title, "#{@collection.name} revisions · Prompt Refinery" %>

<main class="collections-page">
  <nav><%= link_to "← Collection", @collection %></nav>
  <header>
    <p class="eyebrow">Collection history</p>
    <h1><%= @collection.name %></h1>
    <p>Compare the current working state with immutable revisions previously used in trials.</p>
  </header>

  <h2 class="history-heading">Current revision</h2>
  <section class="editor-card current-revision">
    <header class="revision-header">
      <div>
        <p>
          <% if @has_unrevised_changes %>
            Draft · Will become r<%= @current_revision_number %> when used in a trial
          <% else %>
            <p>Revision <%= @latest_revision.version %> · Captured <%= time_ago_in_words(@latest_revision.created_at) %> ago · <%= pluralize(@latest_revision.trials.size, "trial") %></p>
          <% end %>
        </p>
      </div>
      <span class="status <%= "status--running" if @has_unrevised_changes %>"><%= @has_unrevised_changes ? "Draft" : "Current" %></span>
    </header>

    <% if @current_prompts.empty? %>
      <p>This collection currently contains no prompts.</p>
    <% else %>
      <ol class="revision-prompts">
        <% @current_prompts.each do |prompt| %>
          <li>
            <h3><%= prompt.name %></h3>
            <div class="result-content"><%= simple_format(prompt.template) %></div>
          </li>
        <% end %>
      </ol>
    <% end %>
  </section>

  <h2 class="history-heading">Previous revisions</h2>
  <% if @revisions.empty? %>
    <section class="notice">
      <p>No previous revisions yet.</p>
    </section>
  <% else %>
    <div class="revision-list">
      <% @revisions.each do |revision| %>
        <section class="editor-card">
          <header class="revision-header">
            <div>
              <p>Revision <%= revision.version %> · Captured <%= time_ago_in_words(revision.created_at) %> ago · <%= pluralize(revision.trials.size, "trial") %></p>
            </div>
          </header>

          <% if revision.collection_revision_prompts.empty? %>
            <p>This revision contains no prompts.</p>
          <% else %>
            <ol class="revision-prompts">
              <% revision.collection_revision_prompts.each do |member| %>
                <li>
                  <h3><%= member.prompt_revision.name %> <small>r<%= member.prompt_revision.version %></small></h3>
                  <div class="result-content"><%= simple_format(member.prompt_revision.template) %></div>
                </li>
              <% end %>
            </ol>
          <% end %>
        </section>
      <% end %>
    </div>
  <% end %>
</main>
