<% content_for :title, "Dashboard · Prompt Refinery" %>

<main class="dashboard-page">
  <header>
    <p class="eyebrow">Prompt Refinery</p>
    <h1>Dashboard</h1>
    <p>Models, prompt collections, and evaluation trials at a glance.</p>
    <%= button_to "Sign out", logout_path, method: :delete, class: "text-button" %>
  </header>

  <div class="dashboard-grid">
    <section class="dashboard-panel">
      <header><h2>Models</h2><%= link_to "View all", models_path %></header>
      <% if @ollama_error %>
        <p class="form-error" role="alert"><%= @ollama_error %></p>
      <% elsif @models.empty? %>
        <p>No models installed.</p>
      <% else %>
        <ul>
          <% @models.each do |model| %>
            <li>
              <%= link_to model.fetch("name", "Unnamed model"), prompt_path(model: model["name"]) %>
              <% if model["modified_at"] %>
                <small>Updated <%= time_ago_in_words(Time.zone.parse(model["modified_at"])) %> ago</small>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="dashboard-panel">
      <header><h2>Collections</h2><%= link_to "Manage", collections_path %></header>
      <% if @collections.empty? %>
        <p>No collections yet.</p>
      <% else %>
        <ul>
          <% @collections.each do |collection| %>
            <li>
              <%= link_to collection.name, collection %>
              <small>Updated <%= time_ago_in_words(collection.updated_at) %> ago</small>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="dashboard-panel">
      <header><h2>Trials</h2><%= link_to "Manage", trials_path %></header>
      <% if @trials.empty? %>
        <p>No trials yet.</p>
      <% else %>
        <ul>
          <% @trials.each do |trial| %>
            <li>
              <%= link_to "#{trial.collection.name} · #{trial.model}", trial %>
              <small>
                <span class="status status--<%= trial.status %>"><%= trial.status.humanize %></span>
                <% if trial.completed? && trial.completed_at %>
                  <time datetime="<%= trial.completed_at.iso8601 %>"><%= time_ago_in_words(trial.completed_at) %> ago</time>
                <% end %>
              </small>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </div>
</main>
