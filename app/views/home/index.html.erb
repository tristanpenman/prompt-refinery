<% content_for :title, "Dashboard · Prompt Refinery" %>

<main class="dashboard-page">
  <header>
    <p class="eyebrow">Prompt Refinery</p>
    <h1>Dashboard</h1>
    <p>Prompts, test suites, and evaluation trials at a glance.</p>
    <div class="dashboard-actions">
      <%= link_to "Settings", settings_path %>
      <%= button_to "Sign out", logout_path, method: :delete, class: "text-button" %>
    </div>
  </header>

  <div class="dashboard-grid">
    <section class="dashboard-panel">
      <header><h2>Prompts</h2><%= link_to "View all", prompts_path %></header>
      <% if @prompts.empty? %>
        <p>No prompts yet.</p>
      <% else %>
        <ul>
          <% @prompts.each do |prompt| %>
            <li>
              <%= link_to prompt.name, prompt %>
              <small>Updated <%= time_ago_in_words(prompt.updated_at) %> ago</small>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="dashboard-panel">
      <header><h2>Test Suites</h2><%= link_to "View all", test_suites_path %></header>
      <% if @test_suites.empty? %>
        <p>No test suites yet.</p>
      <% else %>
        <ul>
          <% @test_suites.each do |test_suite| %>
            <li>
              <%= link_to test_suite.name, test_suite %>
              <small>Updated <%= time_ago_in_words(test_suite.updated_at) %> ago</small>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="dashboard-panel">
      <header><h2>Trials</h2><%= link_to "View all", trials_path %></header>
      <% if @trials.empty? %>
        <p>No trials yet.</p>
      <% else %>
        <ul>
          <% @trials.each do |trial| %>
            <li>
              <%= link_to "#{trial.prompt_revision.name} · #{trial.test_suite_revision.name} · #{trial.model}", trial %>
              <small>
                <span class="status status--<%= trial.status %>"><%= trial.status.humanize %></span>
                <% if trial.completed? && trial.completed_at %>
                  <time datetime="<%= trial.completed_at.iso8601 %>"><%= time_ago_in_words(trial.completed_at) %> ago</time>
                <% end %>
              </small>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </div>
</main>
