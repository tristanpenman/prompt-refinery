<% if record.errors.any? %>
  <div class="form-error" role="alert">
    <p><%= pluralize(record.errors.count, "error") %> prevented this from being saved:</p>
    <ul>
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
