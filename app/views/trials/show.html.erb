<% content_for :title, "Trial ##{@trial.id} · Prompt Refinery" %>
<% content_for :head do %>
  <% if @trial.pending? || @trial.running? %>
    <meta http-equiv="refresh" content="2">
  <% end %>
<% end %>

<main class="trials-page">
  <nav><%= link_to "← Trials", trials_path %></nav>
  <header>
    <p class="eyebrow">Trial #<%= @trial.id %></p>
    <h1><%= @trial.prompt_revision.name %></h1>
  </header>

  <section class="editor-card">
    <h2>Trial details</h2>
    <p>Prompt: <%= @trial.prompt_revision.name %> r<%= @trial.prompt_revision.version %></p>
    <p>Test suite: <%= link_to @trial.test_suite_revision.name, @trial.test_suite_revision.test_suite %> r<%= @trial.test_suite_revision.version %></p>
    <p>Backend: <%= @trial.backend_name %> (<code><%= @trial.backend_base_url %></code>)</p>
    <p>Model: <%= @trial.model %></p>
    <p>Created: <time datetime="<%= @trial.created_at.iso8601 %>"><%= @trial.created_at.to_fs(:long) %></time></p>
    <p>Status: <span class="status status--<%= @trial.status %>"><%= @trial.status.humanize %></span></p>
    <%= link_to "Compare trial", compare_trial_path(@trial) %>
  </section>

  <% if @trial.pending? || @trial.running? %>
    <section class="notice" role="status">
      <h2>Generating responses…</h2>
      <p>This page refreshes automatically while the background job is running.</p>
    </section>
  <% end %>

  <section class="trial-responses">
    <h2>Responses</h2>
    <% if @responses.empty? %>
      <p>This trial has no test cases.</p>
    <% else %>
      <% @responses.each.with_index(1) do |response, number| %>
        <% test_case_revision = response.test_suite_revision_case.test_case_revision %>
        <article class="evaluation-result">
          <h3>Test case <%= number %> <small>r<%= test_case_revision.version %></small></h3>
          <p><span class="status status--<%= response.status %>"><%= response.status.humanize %></span></p>
          <section class="response-prompt">
            <h4>Variables</h4>
            <%= render "test_suite_revisions/test_case_values", variables: @trial.test_suite_revision.variables, values: test_case_revision.values %>
          </section>
          <section class="response-prompt">
            <h4>Prompt</h4>
            <div class="result-content"><%= simple_format(response.rendered_prompt) %></div>
          </section>
          <section class="response-prompt">
            <h4>Response</h4>
            <% if response.error? %>
              <p class="form-error" role="alert"><%= response.error %></p>
            <% elsif response.content? %>
              <div class="result-content markdown-content"><%= render_markdown(response.content) %></div>
            <% end %>
          </section>
        </article>
      <% end %>
    <% end %>
  </section>
</main>
