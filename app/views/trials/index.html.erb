<% content_for :title, "Trials · Prompt Refinery" %>

<main class="trials-page">
  <nav><%= link_to "← Dashboard", root_path %></nav>
  <header>
    <p class="eyebrow">Prompt Refinery</p>
    <h1>Trials</h1>
    <p>Run a prompt against every test case in a test suite in the background.</p>
  </header>

  <section class="editor-card">
    <h2>New trial</h2>
    <%= render "shared/errors", record: @trial if @trial %>
    <% if @ollama_error %>
      <p class="form-error" role="alert"><%= @ollama_error %></p>
    <% elsif @backends.empty? %>
      <p><%= link_to "Enable a backend", settings_backends_path %> before starting a trial.</p>
    <% elsif @prompts.empty? %>
      <p><%= link_to "Create a prompt", prompts_path %> before starting a trial.</p>
    <% elsif @test_suites.empty? %>
      <p><%= link_to "Create a test suite with test cases", test_suites_path %> before starting a trial.</p>
    <% elsif @models.empty? %>
      <p>No models are installed on <%= @selected_backend.name %>.</p>
    <% else %>
      <%= form_with url: trials_path, method: :get do |form| %>
        <%= form.label :backend_id, "Backend" %>
        <%= form.collection_select :backend_id, @backends, :id, :name, { selected: @selected_backend.id }, required: true %>
        <%= form.submit "Select backend" %>
      <% end %>
      <%= form_with model: @trial || Trial.new do |form| %>
        <%= form.hidden_field :backend_id, value: @selected_backend.id %>
        <%= form.label :prompt_id, "Prompt" %>
        <%= form.collection_select :prompt_id, @prompts, :id, :name,
          { prompt: "Choose a prompt", selected: @selected_prompt_id }, required: true %>
        <%= form.label :test_suite_id, "Test suite" %>
        <%= form.collection_select :test_suite_id, @test_suites, :id, :name,
          { prompt: "Choose a test suite", selected: @selected_test_suite_id }, required: true %>
        <%= form.label :model %>
        <%= form.select :model, @models, { prompt: "Choose a model" }, required: true %>
        <%= form.submit "Create trial" %>
      <% end %>
    <% end %>
  </section>

  <section class="editor-card trial-list">
    <h2>Previous trials</h2>
    <% if @trials.empty? %>
      <p>No trials yet.</p>
    <% else %>
      <table>
        <thead>
          <tr><th>Prompt</th><th>Test suite</th><th>Backend</th><th>Model</th><th>Status</th><th>Created</th></tr>
        </thead>
        <tbody>
          <% @trials.each do |trial| %>
            <tr>
              <td><%= link_to "#{trial.prompt_revision.name} r#{trial.prompt_revision.version}", trial %></td>
              <td><%= trial.test_suite_revision.name %> r<%= trial.test_suite_revision.version %></td>
              <td><%= trial.backend_name %></td>
              <td><%= trial.model %></td>
              <td><span class="status status--<%= trial.status %>"><%= trial.status.humanize %></span></td>
              <td><%= time_ago_in_words(trial.created_at) %> ago</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>
</main>
