<% content_for :title, "Evaluate #{@model} · Prompt Refinery" %>

<main class="evaluation-page">
  <nav><%= link_to "← Models", models_path %></nav>
  <header>
    <p class="eyebrow">Evaluate model</p>
    <h1><%= @model %></h1>
    <p>Run every prompt in a collection sequentially against this model.</p>
  </header>

  <% if @collections.empty? %>
    <section class="notice">
      <h2>No collections available</h2>
      <p><%= link_to "Create a prompt collection", collections_path %> before starting an evaluation.</p>
    </section>
  <% else %>
    <%= form_with url: evaluate_path, class: "evaluation-form", data: { controller: "evaluation", action: "turbo:submit-start->evaluation#start turbo:submit-end->evaluation#finish" } do |form| %>
      <%= form.hidden_field :model, value: @model %>
      <%= form.label :collection_id, "Prompt collection" %>
      <%= form.collection_select :collection_id, @collections, :id, :name, { selected: @collection&.id }, required: true %>
      <%= form.submit "Run evaluation", data: { evaluation_target: "submit" } %>
      <p class="generating-status" data-evaluation-target="status" role="status" hidden>
        Evaluating prompts one by one…
      </p>
    <% end %>
  <% end %>

  <%= render "results" %>
</main>
