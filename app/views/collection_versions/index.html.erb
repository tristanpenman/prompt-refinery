<% content_for :title, "#{@collection.name} versions · Prompt Refinery" %>

<main class="collections-page">
  <nav><%= link_to "← Collection", @collection %></nav>
  <header>
    <p class="eyebrow">Collection history</p>
    <h1><%= @collection.name %></h1>
    <p>Compare the current working state with immutable versions previously used in trials.</p>
  </header>

  <h2 class="history-heading">Current version</h2>
  <section class="editor-card current-version">
    <header class="version-header">
      <div>
        <p>
          <% if @has_unversioned_changes %>
            Draft · Will become v<%= @current_version %> when used in a trial
          <% else %>
            v<%= @current_version %>
          <% end %>
        </p>
      </div>
      <span class="status <%= "status--running" if @has_unversioned_changes %>"><%= @has_unversioned_changes ? "Draft" : "Current" %></span>
    </header>

    <% if @current_prompts.empty? %>
      <p>This collection currently contains no prompts.</p>
    <% else %>
      <ol class="version-prompts">
        <% @current_prompts.each do |prompt| %>
          <li>
            <h3><%= prompt.name %></h3>
            <div class="result-content"><%= simple_format(prompt.template) %></div>
          </li>
        <% end %>
      </ol>
    <% end %>
  </section>

  <h2 class="history-heading">Previous versions</h2>
  <% if @versions.empty? %>
    <section class="notice">
      <p>No previous versions yet.</p>
    </section>
  <% else %>
    <div class="version-list">
      <% @versions.each do |version| %>
        <section class="editor-card">
          <header class="version-header">
            <div>
              <p>Version <%= version.version %> · Captured <%= time_ago_in_words(version.created_at) %> ago · <%= pluralize(version.trials.size, "trial") %></p>
            </div>
          </header>

          <% if version.collection_revision_prompts.empty? %>
            <p>This version contains no prompts.</p>
          <% else %>
            <ol class="version-prompts">
              <% version.collection_revision_prompts.each do |member| %>
                <li>
                  <h3><%= member.prompt_revision.name %> <small>v<%= member.prompt_revision.version %></small></h3>
                  <div class="result-content"><%= simple_format(member.prompt_revision.template) %></div>
                </li>
              <% end %>
            </ol>
          <% end %>
        </section>
      <% end %>
    </div>
  <% end %>
</main>
