<% content_for :title, "Collections · Prompt Refinery" %>

<main class="collections-page">
  <nav><%= link_to "← Dashboard", root_path %></nav>
  <header>
    <p class="eyebrow">Prompt Refinery</p>
    <h1>Collections</h1>
    <p>Group related prompts so they can be evaluated together.</p>
  </header>

  <section class="editor-card">
    <h2>New collection</h2>
    <%= render "shared/errors", record: @collection %>
    <%= form_with model: @collection do |form| %>
      <%= form.label :name %>
      <%= form.text_field :name, required: true, placeholder: "Collection name" %>
      <%= form.submit "Create collection" %>
    <% end %>
  </section>

  <section class="collection-list">
    <h2><%= @show_archived ? "Archived collections" : "Collections" %></h2>
    <% if @collection_rows.empty? %>
      <p><%= @show_archived ? "No archived collections." : "No collections yet." %></p>
    <% else %>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Revision</th>
            <th>Draft</th>
            <th>Prompts</th>
            <th>Created</th>
            <th>Updated</th>
          </tr>
        </thead>
        <tbody>
          <% @collection_rows.each do |row| %>
            <% collection = row[:collection] %>
            <tr>
              <td><%= link_to collection.name, collection %></td>
              <td><%= row[:revision] ? "r#{row[:revision]}" : "N/A" %></td>
              <td>
                <span class="status <%= row[:draft] ? "status--running" : "status--completed" %>">
                  <%= row[:draft] ? "Draft" : "Recorded" %>
                </span>
              </td>
              <td><%= collection.prompts.size %></td>
              <td><time datetime="<%= collection.created_at.iso8601 %>"><%= collection.created_at.to_fs(:short) %></time></td>
              <td><time datetime="<%= collection.updated_at.iso8601 %>"><%= collection.updated_at.to_fs(:short) %></time></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </section>

  <nav class="collection-filter-link">
    <% if @show_archived %>
      <%= link_to "View active collections", collections_path %>
    <% else %>
      <%= link_to "View archived collections", collections_path(archived: true) %>
    <% end %>
  </nav>
</main>
