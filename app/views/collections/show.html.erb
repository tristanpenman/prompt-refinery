<% content_for :title, "#{@collection.name} · Prompt Refinery" %>

<main class="collections-page">
  <nav><%= link_to "← Collections", collections_path %></nav>
  <header>
    <p class="eyebrow">Prompt collection</p>
    <div class="collection-heading">
      <h1><%= @collection.name %></h1>
      <% if @collection.archived_at? %>
        <span class="status status--archived">Archived</span>
      <% end %>
    </div>
  </header>

  <section class="editor-card">
    <h2>Collection details</h2>
    <% if @current_revision %>
      <p><strong>Latest revision:</strong> r<%= @current_revision.version %> (<%= link_to "View revision history", revisions_collection_path(@collection) %>)</p>
      <% if @has_unrevised_changes %>
        <p>There are draft changes. A new revision will be created when the collection is next used in a trial.</p>
      <% end %>
    <% else %>
      <p><strong>Latest revision:</strong> Not revised yet</p>
    <% end %>
    <%= render "shared/errors", record: @collection %>
    <%= form_with model: @collection do |form| %>
      <%= form.label :name %>
      <%= form.text_field :name, required: true %>
      <%= form.submit "Save collection" %>
    <% end %>
    <% if @collection.archived_at? %>
      <%= link_to "Unarchive collection", unarchive_collection_path(@collection), data: { turbo_method: :patch } %>
    <% else %>
      <%= button_to "Archive collection", @collection, method: :delete, class: "danger-button", data: { turbo_confirm: "Archive this collection? It will no longer be available for new trials." } %>
    <% end %>
  </section>

  <section class="prompt-list">
    <h2>Prompts</h2>
    <% if @prompts.empty? %>
      <p>No prompts in this collection yet.</p>
    <% else %>
      <% @prompts.each do |prompt| %>
        <article class="editor-card">
          <%= render "shared/errors", record: prompt %>
          <%= form_with model: [@collection, prompt] do |form| %>
            <div class="prompt-fields">
              <div>
                <%= form.label :name %>
                <%= form.text_field :name, required: true %>
              </div>
              <div>
                <%= form.label :position %>
                <%= form.number_field :position, required: true, min: 0 %>
              </div>
            </div>
            <%= form.label :template, "Prompt text" %>
            <%= form.text_area :template, required: true, rows: 5 %>
            <%= form.submit "Save prompt" %>
          <% end %>
          <%= button_to "Delete prompt", [@collection, prompt], method: :delete, class: "danger-button", data: { turbo_confirm: "Delete this prompt?" } %>
        </article>
      <% end %>
    <% end %>
  </section>

  <section class="editor-card">
    <h2>Add prompt</h2>
    <%= render "shared/errors", record: @prompt %>
    <%= form_with model: [@collection, @prompt] do |form| %>
      <div class="prompt-fields">
        <div>
          <%= form.label :name %>
          <%= form.text_field :name, required: true, placeholder: "Prompt name" %>
        </div>
        <div>
          <%= form.label :position %>
          <%= form.number_field :position, required: true, min: 0 %>
        </div>
      </div>
      <%= form.label :template, "Prompt text" %>
      <%= form.text_area :template, required: true, rows: 5, placeholder: "Write a prompt or use variables such as {{topic}}" %>
      <%= form.submit "Add prompt" %>
    <% end %>
  </section>
</main>
