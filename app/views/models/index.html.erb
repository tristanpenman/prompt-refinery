<% content_for :title, "Models · Prompt Refinery" %>

<main class="models-page">
  <nav><%= link_to "← Dashboard", root_path %></nav>
  <header>
    <p class="eyebrow">Prompt Refinery</p>
    <h1>Available models</h1>
    <p>Models currently available from enabled inference backends.</p>
  </header>

  <% @backend_errors.each do |error| %>
    <section class="notice notice--error" role="alert">
      <h2><%= error.backend.name %> is unavailable</h2>
      <p><%= error.message %></p>
    </section>
  <% end %>

  <% if @models.empty? %>
    <section class="notice">
      <h2>No models installed</h2>
      <p>Install a model on an enabled inference backend.</p>
    </section>
  <% else %>
    <ul class="model-list">
      <% @models.each do |model| %>
        <li>
          <h2><%= model.fetch("name", "Unnamed model") %></h2>
          <p class="model-backend">Backend: <%= model.fetch("backend").name %></p>
          <% if model["details"].present? %>
            <p><%= [model.dig("details", "family"), model.dig("details", "parameter_size"), model.dig("details", "quantization_level")].compact.join(" · ") %></p>
          <% end %>
          <% if model["size"] %>
            <span><%= number_to_human_size(model["size"]) %></span>
          <% end %>
          <div class="model-actions">
            <%= link_to "Select", prompt_path(model: model["name"], backend_id: model.fetch("backend").id), class: "select-button" %>
            <%= link_to "Evaluate", evaluate_path(model: model["name"], backend_id: model.fetch("backend").id), class: "secondary-button" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</main>
