<% content_for :title, "Models · Settings · Prompt Refinery" %>

<main class="models-page">
  <nav><%= link_to "← Settings", settings_path %></nav>
  <header>
    <p class="eyebrow">Settings</p>
    <h1>Models</h1>
    <p>Models currently available from enabled inference backends.</p>
  </header>

  <% if @families.any? %>
    <%= form_with url: settings_models_path, method: :get, class: "model-filter", role: "search" do |form| %>
      <%= form.label :family, "Model family" %>
      <%= form.select :family,
        options_from_collection_for_select(@families, :id, :name, @family&.id),
        include_blank: "All families" %>
      <%= form.submit "Filter", name: nil %>
      <% if @family %>
        <%= link_to "Clear", settings_models_path, class: "secondary-button" %>
      <% end %>
    <% end %>
  <% end %>

  <% @backend_errors.each do |error| %>
    <section class="notice notice--error" role="alert">
      <h2><%= error.backend.name %> is unavailable</h2>
      <p><%= error.message %></p>
    </section>
  <% end %>

  <% if @models.empty? %>
    <section class="notice">
      <h2>No models installed</h2>
      <p>Install a model on an enabled inference backend.</p>
    </section>
  <% else %>
    <ul class="model-list">
      <% @models.each do |model| %>
        <li>
          <h2><%= model.fetch("name", "Unnamed model") %></h2>
          <p class="model-backend">Backend: <%= model.fetch("backend").name %></p>
          <% if model["language_model"] %>
            <p class="model-family">Family: <%= model["language_model"].language_model_family.name %></p>
          <% end %>
          <% if model["details"].present? %>
            <p><%= [model.dig("details", "family"), model.dig("details", "parameter_size"), model.dig("details", "quantization_level")].compact.join(" · ") %></p>
          <% end %>
          <% if model["size"] %>
            <span><%= number_to_human_size(model["size"]) %></span>
          <% end %>
          <div class="model-actions">
            <%= link_to "Select", playground_path(model: model["name"], backend_id: model.fetch("backend").id), class: "select-button" %>
            <%= link_to "Evaluate", evaluate_path(model: model["name"], backend_id: model.fetch("backend").id), class: "secondary-button" %>
            <% if model["language_model"] %>
              <%= link_to "Edit", edit_settings_model_path(model["language_model"]), class: "secondary-button" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</main>
