<% content_for :title, "Models · Settings · Prompt Refinery" %>

<main class="models-page">
  <nav><%= link_to "← Settings", settings_path %></nav>
  <header>
    <p class="eyebrow">Settings</p>
    <h1>Models</h1>
    <p>Models found on inference backends. A model stays listed after it is removed from its backend.</p>
  </header>

  <section class="notice model-refresh">
    <h2>Refresh models</h2>
    <p>Check every enabled backend for models, and record any that are new.</p>
    <%= button_to "Refresh", refresh_settings_models_path, class: "primary-button" %>
  </section>

  <% if @families.any? %>
    <%= form_with url: settings_models_path, method: :get, class: "model-filter", role: "search" do |form| %>
      <%= form.label :family, "Model family" %>
      <%= form.select :family,
        options_from_collection_for_select(@families, :id, :name, @family&.id),
        include_blank: "All families" %>
      <%= form.submit "Filter", name: nil %>
      <% if @family %>
        <%= link_to "Clear", settings_models_path, class: "secondary-button" %>
      <% end %>
    <% end %>
  <% end %>

  <% if @language_models.empty? %>
    <section class="notice">
      <h2>No models recorded</h2>
      <p>Install a model on an enabled inference backend, then refresh.</p>
    </section>
  <% else %>
    <ul class="model-list">
      <% @language_models.each do |language_model| %>
        <% backend = language_model.backend %>
        <li>
          <h2><%= language_model.name %></h2>
          <p class="model-backend">
            Backend: <%= backend.name %>
            <% unless backend.enabled? %>
              <span class="status">Disabled</span>
            <% end %>
          </p>
          <p class="model-family">Family: <%= language_model.language_model_family.name %></p>
          <% details = language_model.details.values_at("family", "parameter_size", "quantization_level").compact %>
          <% if details.any? %>
            <p><%= details.join(" · ") %></p>
          <% end %>
          <% if language_model.size %>
            <span><%= number_to_human_size(language_model.size) %></span>
          <% end %>
          <p class="model-refreshed">
            Last refreshed
            <time datetime="<%= language_model.refreshed_at.iso8601 %>" title="<%= language_model.refreshed_at.to_fs(:long) %>"><%= time_ago_in_words(language_model.refreshed_at) %> ago</time>
          </p>
          <div class="model-actions">
            <% if backend.enabled? %>
              <%= link_to "Select", playground_path(model: language_model.name, backend_id: backend.id), class: "select-button" %>
              <%= link_to "Evaluate", evaluate_path(model: language_model.name, backend_id: backend.id), class: "secondary-button" %>
            <% end %>
            <%= link_to "Edit", edit_settings_model_path(language_model), class: "secondary-button" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</main>
