<% content_for :title, "Models · Settings · Prompt Refinery" %>

<main class="models-page">
  <nav><%= link_to "← Settings", settings_path %></nav>
  <header>
    <p class="eyebrow">Settings</p>
    <h1>Models</h1>
    <p>Models found on inference backends. A model stays listed as unavailable after it is removed from its backend.</p>
  </header>

  <section class="notice model-refresh">
    <h2>Refresh models</h2>
    <p>Check every enabled backend for models, and record any that are new.</p>
    <%= button_to "Refresh", refresh_settings_models_path, class: "primary-button" %>
  </section>

  <% if @families.any? %>
    <%= form_with url: settings_models_path, method: :get, class: "model-filter", role: "search" do |form| %>
      <%= form.label :family, "Model family" %>
      <%= form.select :family,
        options_from_collection_for_select(@families, :id, :name, @family&.id),
        include_blank: "All families" %>
      <%= form.submit "Filter", name: nil %>
      <% if @family %>
        <%= link_to "Clear", settings_models_path, class: "secondary-button" %>
      <% end %>
    <% end %>
  <% end %>

  <% if @available_models.empty? && @unavailable_models.empty? %>
    <section class="notice">
      <h2>No models recorded</h2>
      <p>Install a model on an enabled inference backend, then refresh.</p>
    </section>
  <% else %>
    <% if @available_models.any? %>
      <section class="model-group">
        <h2>Available</h2>
        <ul class="model-list">
          <%= render partial: "language_model", collection: @available_models %>
        </ul>
      </section>
    <% end %>
    <% if @unavailable_models.any? %>
      <section class="model-group">
        <h2>Unavailable</h2>
        <p>Not found on their backend at the last refresh.</p>
        <ul class="model-list">
          <%= render partial: "language_model", collection: @unavailable_models %>
        </ul>
      </section>
    <% end %>
  <% end %>
</main>
