<%= form.label :adapter %>
<%= form.select :adapter, [["Ollama", "ollama"], ["Amazon Bedrock", "bedrock"]], {}, disabled: backend.persisted?, data: { backend_configuration_target: "adapter", action: "backend-configuration#update" } %>
<% if backend.persisted? %>
  <p>Create another backend to switch providers.</p>
<% end %>

<div data-backend-configuration-target="ollama" <%= "hidden" if backend.bedrock? %>>
  <%= form.label :base_url, "Base URL" %>
  <%= form.url_field :base_url, required: !backend.bedrock?, disabled: backend.bedrock?, placeholder: "http://edge-board.local:8080" %>
</div>
<div data-backend-configuration-target="bedrock" <%= "hidden" unless backend.bedrock? %>>
  <p>AWS region: <%= ENV["AWS_REGION"].presence || "Not configured" %>. Configure AWS_REGION and credentials in the application environment. AWS determines the endpoint.</p>
  <p>Bedrock generation and model discovery are not available yet.</p>
</div>
