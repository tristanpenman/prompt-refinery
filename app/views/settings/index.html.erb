<% content_for :title, "Settings · Prompt Refinery" %>

<main class="dashboard-page">
  <header>
    <p class="eyebrow">Prompt Refinery</p>
    <h1>Settings</h1>
    <p>Configure Prompt Refinery and its inference services.</p>
    <%= link_to "← Dashboard", root_path %>
  </header>

  <div class="dashboard-grid">
    <section class="dashboard-panel">
      <header><h2>Backends</h2><%= link_to "View all", settings_backends_path %></header>
      <% if @backends.empty? %>
        <p>No backends configured.</p>
      <% else %>
        <ul>
          <% @backends.each do |backend| %>
            <li>
              <%= link_to backend.name, settings_backends_path(anchor: dom_id(backend)) %>
              <small>
                <%= backend.adapter %> · <%= backend.enabled? ? "Enabled" : "Disabled" %>
                <% if backend.system? %> · System<% end %>
              </small>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="dashboard-panel" id="model-families">
      <header><h2>Model Families</h2></header>
      <% if @language_model_families.empty? %>
        <p>No model families registered.</p>
      <% else %>
        <ul>
          <% @language_model_families.each do |family| %>
            <li>
              <%= family.name %>
              <small><%= pluralize(family.language_models_count, "model") %></small>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section class="dashboard-panel" id="models">
      <header><h2>Models</h2><%= link_to "View all", settings_models_path %></header>
      <% @backend_errors.each do |error| %>
        <p class="form-error" role="alert"><%= error.backend.name %>: <%= error.message %></p>
      <% end %>
      <% if @models.empty? %>
        <p>No models installed.</p>
      <% else %>
        <ul>
          <% @models.each do |model| %>
            <li>
              <%= link_to model.fetch("name", "Unnamed model"), playground_path(model: model["name"], backend_id: model.fetch("backend").id) %>
              <small>
                <%= model.fetch("backend").name %>
                <% if model["modified_at"] %>
                  · Updated <%= time_ago_in_words(Time.zone.parse(model["modified_at"])) %> ago
                <% end %>
              </small>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </div>
</main>
